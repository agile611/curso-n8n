events {
    worker_connections 1024;
}

http {
    # Use Docker's internal DNS resolver for runtime service discovery
    resolver 127.0.0.11 valid=10s;

    upstream n8n_backend {
        server n8n:5678;
    }
    
    upstream dify_backend {
        server dify-web:3000;
    }
    
    upstream dify_api_backend {
        server dify-api:5001;
    }
    
    upstream docs_backend {
        server docs:8001;
    }

    server {
        listen 80;
        server_name ${LAB_HOST};

        # Root: redirect to documentation
        location = / {
            return 302 /docs/;
        }

        # ============================================================
        # N8N - All paths under /n8n/ proxied to n8n backend
        # ============================================================
        location /n8n/ {
            proxy_pass http://n8n_backend/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Prefix /n8n;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            
            # Handle n8n redirects to keep them under /n8n/
            proxy_redirect http://$host/ /n8n/;
            proxy_redirect http://$host:5678/ /n8n/;
            proxy_redirect http://$host/setup /n8n/setup;
            proxy_redirect http://$host:5678/setup /n8n/setup;
        }

        # n8n API endpoints (REST API)
        location /n8n/rest/ {
            proxy_pass http://n8n_backend/rest/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        location /n8n/api/ {
            proxy_pass http://n8n_backend/api/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        # n8n static assets
        location /static/ {
            proxy_pass http://n8n_backend/static/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        location /assets/ {
            proxy_pass http://n8n_backend/assets/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # ============================================================
        # DIFY - All paths under /dify/ proxied to dify-web backend
        # ============================================================
        location /dify/ {
            proxy_pass http://dify_backend/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Prefix /dify;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            
            # Handle Dify redirects to keep them under /dify/
            proxy_redirect http://$host/ /dify/;
            proxy_redirect http://$host:3000/ /dify/;
        }

        # Dify install/setup wizard (redirects from / to /install)
        location /install {
            proxy_pass http://dify_backend/install;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Prefix /dify;
        }

        # Dify Console API (browser calls from Dify web UI) - proxied to dify-api
        location /dify/console/api/ {
            proxy_pass http://dify_api_backend/console/api/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        # Dify static assets (_next/, logo/) - serve from dify-web
        location /_next/ {
            proxy_pass http://dify_backend/_next/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        location /logo/ {
            proxy_pass http://dify_backend/logo/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # ============================================================
        # DOCUMENTATION (MkDocs) - All paths under /docs/
        # ============================================================
        location /docs/ {
            proxy_pass http://docs_backend/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Prefix /docs;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            
            # Handle MkDocs redirects
            proxy_redirect http://$host/ /docs/;
            proxy_redirect http://$host:8001/ /docs/;
        }

        # MkDocs live reload (WebSocket)
        location /livereload {
            proxy_pass http://docs_backend/livereload;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        # Health check
        location /health {
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }
    }
}